  "fakeroku.0.info.connection": {
    "_id": "fakeroku.0.info.connection",
    "type": "state",
    "common": {
      "role": "indicator.connected",
      "name": {
        "en": "Connection status",
        "de": "Verbindungsstatus",
        "ru": "Статус подключения",
        "pt": "Estado da ligação",
        "nl": "Verbindingsstatus",
        "fr": "État de la connexion",
        "it": "Stato connessione",
        "es": "Estado de conexión",
        "pl": "Stan połączenia",
        "uk": "Стан з'єднання",
        "zh-cn": "连接状态"
      },
      "type": "boolean",
      "read": true,
      "write": false,
      "def": false,
      "desc": {
        "en": "True only while every configured emulated Roku is actually listening.",
        "de": "Nur wahr, solange jeder konfigurierte emulierte Roku tatsächlich lauscht.",
        "ru": "Истина только пока каждый настроенный эмулированный Roku действительно слушает.",
        "pt": "Verdadeiro apenas enquanto todos os Roku emulados configurados estiverem realmente à escuta.",
        "nl": "Alleen waar zolang elke geconfigureerde geëmuleerde Roku daadwerkelijk luistert.",
        "fr": "Vrai uniquement tant que chaque Roku émulé configuré est réellement à l'écoute.",
        "it": "Vero solo finché ogni Roku emulato configurato è effettivamente in ascolto.",
        "es": "Verdadero solo mientras cada Roku emulado configurado esté realmente a la escucha.",
        "pl": "Prawda tylko wtedy, gdy każdy skonfigurowany emulowany Roku faktycznie nasłuchuje.",
        "uk": "Істина лише поки кожен налаштований емульований Roku справді слухає.",
        "zh-cn": "仅当每个已配置的模拟 Roku 都在监听时才为真。"
      }
    },
    "native": {}
  },
