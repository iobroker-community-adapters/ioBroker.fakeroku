  "fakeroku.0.info.connection": {
    "_id": "fakeroku.0.info.connection",
    "type": "state",
    "common": {
      "role": "indicator.connected",
      "name": {
        "en": "Connection status",
        "de": "Verbindungsstatus",
        "ru": "Статус подключения",
        "pt": "Estado da ligação",
        "nl": "Verbindingsstatus",
        "fr": "État de la connexion",
        "it": "Stato connessione",
        "es": "Estado de conexión",
        "pl": "Stan połączenia",
        "uk": "Стан з'єднання",
        "zh-cn": "连接状态"
      },
      "type": "boolean",
      "read": true,
      "write": false,
      "def": false,
      "desc": {
        "en": "True only while everything runs: every configured emulated Roku listens, discovery answers and the chosen address exists.",
        "de": "Nur wahr, solange alles läuft: jeder konfigurierte emulierte Roku lauscht, die Erkennung antwortet und die gewählte Adresse existiert.",
        "ru": "Истина только пока всё работает: каждый настроенный эмулированный Roku слушает, обнаружение отвечает и выбранный адрес существует.",
        "pt": "Verdadeiro apenas enquanto tudo funciona: cada Roku emulado configurado está à escuta, a descoberta responde e o endereço escolhido existe.",
        "nl": "Alleen waar zolang alles draait: elke geconfigureerde geëmuleerde Roku luistert, de detectie antwoordt en het gekozen adres bestaat.",
        "fr": "Vrai uniquement tant que tout fonctionne : chaque Roku émulé configuré écoute, la découverte répond et l'adresse choisie existe.",
        "it": "Vero solo finché tutto funziona: ogni Roku emulato configurato è in ascolto, il rilevamento risponde e l'indirizzo scelto esiste.",
        "es": "Verdadero solo mientras todo funciona: cada Roku emulado configurado escucha, la detección responde y la dirección elegida existe.",
        "pl": "Prawda tylko wtedy, gdy wszystko działa: każdy skonfigurowany emulowany Roku nasłuchuje, wykrywanie odpowiada, a wybrany adres istnieje.",
        "uk": "Істина лише поки все працює: кожен налаштований емульований Roku слухає, виявлення відповідає і вибрана адреса існує.",
        "zh-cn": "仅当一切正常运行时才为真：每个已配置的模拟 Roku 都在监听、发现服务有应答且所选地址存在。"
      }
    },
    "native": {}
  },
  "fakeroku.0.info.devicesAllOnline": {
    "_id": "fakeroku.0.info.devicesAllOnline",
    "type": "state",
    "common": {
      "role": "indicator",
      "name": {
        "en": "All emulated Rokus online",
        "de": "Alle emulierten Rokus online",
        "ru": "Все эмулированные Roku в сети",
        "pt": "Todos os Rokus emulados online",
        "nl": "Alle geëmuleerde Roku's online",
        "fr": "Tous les Rokus émulés en ligne",
        "it": "Tutti i Roku emulati online",
        "es": "Todos los Rokus emulados en línea",
        "pl": "Wszystkie emulowane Roku online",
        "uk": "Усі емульовані Roku у мережі",
        "zh-cn": "所有模拟 Roku 均在线"
      },
      "type": "boolean",
      "read": true,
      "write": false,
      "def": false,
      "desc": {
        "en": "True while every configured emulated Roku listens; false while none is configured.",
        "de": "Wahr, solange jeder eingerichtete emulierte Roku lauscht; falsch, solange keiner eingerichtet ist.",
        "ru": "Истина, пока слушает каждый настроенный эмулированный Roku; ложь, пока ни один не настроен.",
        "pt": "Verdadeiro enquanto cada Roku emulado configurado está à escuta; falso enquanto nenhum está configurado.",
        "nl": "Waar zolang elke ingestelde geëmuleerde Roku luistert; onwaar zolang er geen is ingesteld.",
        "fr": "Vrai tant que chaque Roku émulé configuré écoute ; faux tant qu'aucun n'est configuré.",
        "it": "Vero finché ogni Roku emulato configurato è in ascolto; falso finché nessuno è configurato.",
        "es": "Verdadero mientras cada Roku emulado configurado escucha; falso mientras no hay ninguno configurado.",
        "pl": "Prawda, dopóki nasłuchuje każdy skonfigurowany emulowany Roku; fałsz, dopóki żaden nie jest skonfigurowany.",
        "uk": "Істина, поки слухає кожен налаштований емульований Roku; хибність, поки жоден не налаштований.",
        "zh-cn": "每个已配置的模拟 Roku 都在监听时为真；未配置任何 Roku 时为假。"
      }
    },
    "native": {}
  },
