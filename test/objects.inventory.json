  "fakeroku.0.Player.command": {
    "type": "state",
    "common": {
      "name": {
        "de": "Letzter Befehl",
        "en": "Last command",
        "es": "Último comando",
        "fr": "Dernière commande",
        "it": "Ultimo comando",
        "nl": "Laatste opdracht",
        "pl": "Ostatnie polecenie",
        "pt": "Último comando",
        "ru": "Последняя команда",
        "uk": "Остання команда",
        "zh-cn": "最后一条命令"
      },
      "desc": {
        "de": "Der zuletzt empfangene Befehl dieses emulierten Roku als Klartext.",
        "en": "The most recent command this emulated Roku received, as plain text.",
        "es": "El comando más reciente que recibió este Roku emulado, como texto simple.",
        "fr": "La commande la plus récente reçue par ce Roku émulé, en texte brut.",
        "it": "Il comando più recente ricevuto da questo Roku emulato, come testo semplice.",
        "nl": "De meest recente opdracht die deze geëmuleerde Roku ontving, als platte tekst.",
        "pl": "Najnowsze polecenie odebrane przez ten emulowany Roku, jako zwykły tekst.",
        "pt": "O comando mais recente recebido por este Roku emulado, em texto simples.",
        "ru": "Последняя команда, полученная этим эмулированным Roku, в виде текста.",
        "uk": "Найновіша команда, яку отримав цей емульований Roku, у вигляді тексту.",
        "zh-cn": "该模拟 Roku 最近收到的命令，以纯文本表示。"
      },
      "type": "string",
      "role": "text",
      "read": true,
      "write": false,
      "def": ""
    },
    "native": {},
    "_id": "fakeroku.0.Player.command"
  },
  "fakeroku.0.Player.commandType": {
    "type": "state",
    "common": {
      "name": {
        "de": "Art des letzten Befehls",
        "en": "Last command type",
        "es": "Tipo del último comando",
        "fr": "Type de la dernière commande",
        "it": "Tipo dell'ultimo comando",
        "nl": "Type laatste opdracht",
        "pl": "Typ ostatniego polecenia",
        "pt": "Tipo do último comando",
        "ru": "Тип последней команды",
        "uk": "Тип останньої команди",
        "zh-cn": "最后一条命令的类型"
      },
      "desc": {
        "de": "Um welche Art Befehl es sich handelte: Tastendruck, Taste gehalten oder losgelassen, App-Start oder -Installation, Texteingabe oder Suche.",
        "en": "What kind of command it was: a key press, a key held or released, an app launch or install, a text input or a search.",
        "es": "Qué tipo de comando fue: pulsar una tecla, mantenerla o soltarla, iniciar o instalar una aplicación, introducir texto o buscar.",
        "fr": "De quel type de commande il s'agissait : appui sur une touche, touche maintenue ou relâchée, lancement ou installation d'une application, saisie de texte ou recherche.",
        "it": "Di che tipo di comando si trattava: pressione di un tasto, tasto tenuto premuto o rilasciato, avvio o installazione di un'app, immissione di testo o ricerca.",
        "nl": "Wat voor soort opdracht het was: een toetsdruk, een toets ingedrukt of losgelaten, een app starten of installeren, tekstinvoer of zoeken.",
        "pl": "Jakiego rodzaju było to polecenie: naciśnięcie klawisza, przytrzymanie lub zwolnienie, uruchomienie lub instalacja aplikacji, wpisanie tekstu albo wyszukiwanie.",
        "pt": "Que tipo de comando foi: pressionar uma tecla, manter ou soltar, iniciar ou instalar uma aplicação, introduzir texto ou pesquisar.",
        "ru": "Какого рода была команда: нажатие кнопки, удержание или отпускание, запуск или установка приложения, ввод текста или поиск.",
        "uk": "Якого роду була команда: натискання кнопки, утримання чи відпускання, запуск або встановлення застосунку, введення тексту чи пошук.",
        "zh-cn": "命令的种类：按键、按住或松开按键、启动或安装应用、输入文本或搜索。"
      },
      "type": "string",
      "role": "text",
      "read": true,
      "write": false,
      "def": "",
      "states": {
        "keypress": "keypress",
        "keydown": "keydown",
        "keyup": "keyup",
        "launch": "launch",
        "install": "install",
        "input": "input",
        "search": "search"
      }
    },
    "native": {},
    "_id": "fakeroku.0.Player.commandType"
  },
  "fakeroku.0.Player.keys": {
