  "fakeroku.0.Player.command": {
    "type": "state",
    "common": {
      "name": {
        "de": "Letzter Befehl",
        "en": "Last command",
        "es": "Último comando",
        "fr": "Dernière commande",
        "it": "Ultimo comando",
        "nl": "Laatste opdracht",
        "pl": "Ostatnie polecenie",
        "pt": "Último comando",
        "ru": "Последняя команда",
        "uk": "Остання команда",
        "zh-cn": "最后一条命令"
      },
      "desc": {
        "de": "Der zuletzt empfangene Befehl dieses emulierten Roku als Klartext.",
        "en": "The most recent command this emulated Roku received, as plain text.",
        "es": "El comando más reciente que recibió este Roku emulado, como texto simple.",
        "fr": "La commande la plus récente reçue par ce Roku émulé, en texte brut.",
        "it": "Il comando più recente ricevuto da questo Roku emulato, come testo semplice.",
        "nl": "De meest recente opdracht die deze geëmuleerde Roku ontving, als platte tekst.",
        "pl": "Najnowsze polecenie odebrane przez ten emulowany Roku, jako zwykły tekst.",
        "pt": "O comando mais recente recebido por este Roku emulado, em texto simples.",
        "ru": "Последняя команда, полученная этим эмулированным Roku, в виде текста.",
        "uk": "Найновіша команда, яку отримав цей емульований Roku, у вигляді тексту.",
        "zh-cn": "该模拟 Roku 最近收到的命令，以纯文本表示。"
      },
      "type": "string",
      "role": "text",
      "read": true,
      "write": false,
      "def": ""
    },
    "native": {},
    "_id": "fakeroku.0.Player.command"
  },
  "fakeroku.0.Player.keys": {
    "type": "channel",
    "common": {
      "name": {
        "de": "Fernbedienungstasten",
        "en": "Remote keys",
        "es": "Teclas del mando",
        "fr": "Touches de la télécommande",
        "it": "Tasti del telecomando",
        "nl": "Afstandsbedieningstoetsen",
        "pl": "Klawisze pilota",
        "pt": "Teclas do comando",
        "ru": "Кнопки пульта",
        "uk": "Кнопки пульта",
        "zh-cn": "遥控器按键"
      },
      "desc": {
        "de": "Ein Datenpunkt je Taste, die dieses Gerät anbietet; ein Tastendruck setzt ihn kurz auf wahr.",
        "en": "One state per remote key this device offers; a key press pulses it briefly.",
        "es": "Un estado por cada tecla que ofrece este dispositivo; una pulsación lo pone brevemente en verdadero.",
        "fr": "Un état par touche proposée par cet appareil ; un appui le met brièvement à vrai.",
        "it": "Uno stato per ogni tasto offerto da questo dispositivo; una pressione lo porta brevemente a vero.",
        "nl": "Eén status per toets die dit apparaat biedt; een toetsdruk zet hem kort op waar.",
        "pl": "Jeden stan na każdy klawisz oferowany przez to urządzenie; naciśnięcie ustawia go na krótko na wartość true.",
        "pt": "Um estado por cada tecla que este dispositivo oferece; uma pressão coloca-o brevemente a verdadeiro.",
        "ru": "По одному состоянию на каждую кнопку пульта этого устройства; нажатие кратко переводит его в истину.",
        "uk": "По одному стану на кожну кнопку, яку пропонує цей пристрій; натискання ненадовго переводить його в істину.",
        "zh-cn": "该设备提供的每个遥控器按键各有一个状态；按下时会短暂置为真。"
      }
    },
    "native": {},
    "_id": "fakeroku.0.Player.keys"
  },
