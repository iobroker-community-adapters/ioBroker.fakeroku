{
  "i18n": true,
  "type": "panel",
  "items": {
    "_intro": {
      "type": "staticText",
      "text": "introText",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "networkInterface": {
      "type": "ip",
      "label": "networkInterface",
      "tooltip": "networkInterfaceTooltip",
      "listenOnAllPorts": true,
      "onlyIp4": true,
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "devices": {
      "type": "table",
      "label": "devicesTable",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12,
      "items": [
        { "type": "text", "attr": "name", "title": "columnName", "width": "60%" },
        { "type": "number", "attr": "port", "title": "columnPort", "width": "40%", "default": 8060 }
      ]
    }
  }
}
